# Postgres (local dev via Homebrew postgresql@16, role/db created by scripts/db-up.sh)
DATABASE_URL="postgresql://forge:forge_dev@localhost:5432/forge_platform"

# AI provider — "openai" or "gemini" (Gemini has a free tier, no billing
# required: get a key at aistudio.google.com/apikey)
AI_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"

# Auth.js
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Booking (Calendly link-only mode needs no credentials)
BOOKING_PROVIDER="calendly-link"
CALENDLY_SCHEDULING_URL="https://calendly.com/forge-digital/growth-audit"

# Seed script
SEED_ADMIN_EMAIL="vandalbamis@gmail.com"
SEED_ADMIN_PASSWORD=""

# Lead notification email (optional — if either is unset, notifications are
# skipped with a console warning instead of failing the request). Gmail
# needs an App Password (myaccount.google.com/apppasswords), not the
# account password. Applies to the current tenant only; see the comment in
# apps/dashboard/lib/email.ts for the multi-tenant caveat.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
LEAD_NOTIFY_EMAIL=""
NEXT_PUBLIC_DASHBOARD_URL="http://localhost:3000"
